# ============================================================
# SKYRA Backend Environment Example
# Copy this file to .env and provide your own values.
# NEVER commit the real .env file.
# ============================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend / CORS
FRONTEND_URL=http://localhost:5500

# Public URL used by QR ticket verification
TICKET_PUBLIC_BASE_URL=http://localhost:5000

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Email / SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@example.com
MAIL_PASSWORD=replace_with_app_password
MAIL_FROM="SKYRA <your_email@example.com>"
